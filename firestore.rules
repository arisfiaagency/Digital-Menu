rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformProfileRef() {
      return /databases/$(database)/documents/adminProfiles/$(request.auth.uid);
    }

    function hasPlatformProfile() {
      return signedIn() && exists(platformProfileRef());
    }

    function platformData() {
      return get(platformProfileRef()).data;
    }

    // Approved platform staff (admin or employee). Never trust JWT admin alone.
    function isPlatformAdmin() {
      return signedIn()
        && hasPlatformProfile()
        && platformData().isAdmin == true
        && platformData().disabled != true;
    }

    // Platform full admin (supervisor). Role must not be employee.
    function isPlatformFullAdmin() {
      return isPlatformAdmin()
        && platformData().role != 'employee';
    }

    function tenantProfileRef(clientId) {
      return /databases/$(database)/documents/clients/$(clientId)/adminProfiles/$(request.auth.uid);
    }

    function hasTenantProfile(clientId) {
      return signedIn() && exists(tenantProfileRef(clientId));
    }

    function tenantData(clientId) {
      return get(tenantProfileRef(clientId)).data;
    }

    // A cafe is "active" (its menu is publicly visible) when its client account
    // exists, is active, and is not blocked. Used to gate anonymous public menu
    // reads of categories / menu items / general+menu settings.
    function clientRef(clientId) {
      return /databases/$(database)/documents/clients/$(clientId);
    }

    function clientActive(clientId) {
      return exists(clientRef(clientId))
        && get(clientRef(clientId)).data.status == 'active'
        && get(clientRef(clientId)).data.get('blocked', false) != true;
    }

    function isTenantAdmin(clientId) {
      return isPlatformFullAdmin()
        || (
          hasTenantProfile(clientId)
          && tenantData(clientId).isAdmin == true
          && tenantData(clientId).disabled != true
        );
    }

    function isTenantFullAdmin(clientId) {
      return isPlatformFullAdmin()
        || (
          hasTenantProfile(clientId)
          && tenantData(clientId).isAdmin == true
          && tenantData(clientId).disabled != true
          && tenantData(clientId).role != 'employee'
        );
    }

    // The cafe's Main Admin (owner) — the only tenant role that reads the Activity
    // Log. Platform full admins keep oversight over every cafe.
    function isTenantMainAdmin(clientId) {
      return isPlatformFullAdmin()
        || (
          hasTenantProfile(clientId)
          && tenantData(clientId).isAdmin == true
          && tenantData(clientId).disabled != true
          && tenantData(clientId).get('isMainAdmin', false) == true
        );
    }

    function hasTenantFeature(clientId, feature) {
      return isTenantFullAdmin(clientId)
        || (
          isTenantAdmin(clientId)
          && tenantData(clientId).get('permissions', {}).get(feature, false) == true
        );
    }

    match /adminProfiles/{uid} {
      allow get: if isPlatformAdmin() || (signedIn() && request.auth.uid == uid);
      allow list, create, update, delete: if isPlatformFullAdmin();
    }

    // Username → email is not world-readable (login resolves via a rate-limited API).
    match /usernames/{username} {
      // Username → email only via rate-limited Admin-SDK API (login / availability).
      allow get, list: if false;
      allow create, update, delete: if isPlatformFullAdmin();
    }

    match /platformPayments/{paymentId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if isPlatformFullAdmin();
    }

    // Secrets (ratings API key hash, etc.) — Admin SDK only; never client SDK.
    match /platformSecrets/{docId} {
      allow read, write: if false;
    }

    match /clients/{clientId} {
      // Full cafe account (billing, owner email, …) is never anonymous-public.
      allow get: if isPlatformAdmin() || isTenantAdmin(clientId);
      allow list: if isPlatformAdmin();
      allow create, update, delete: if isPlatformFullAdmin();

      match /categories/{categoryId} {
        // Public menu: anyone may read active categories of an active cafe.
        allow get, list: if (clientActive(clientId) && resource.data.isActive == true) || isTenantAdmin(clientId);
        allow create, update, delete: if hasTenantFeature(clientId, 'categories');
      }

      match /menuItems/{menuItemId} {
        // Public menu: anyone may read available items of an active cafe.
        allow get, list: if (clientActive(clientId) && resource.data.isAvailable == true) || isTenantAdmin(clientId);
        allow create, delete: if hasTenantFeature(clientId, 'menuItems');
        // POS staff may only flip the POS pin flag; full edits need menuItems.
        allow update: if hasTenantFeature(clientId, 'menuItems')
          || (
            hasTenantFeature(clientId, 'pos')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPosPinned', 'updatedAt'])
          );
      }

      match /settings/{settingsId} {
        // Public menu reads the general + menu settings (never pos).
        allow get, list: if (settingsId in ['general', 'menu'] && clientActive(clientId))
          || (settingsId in ['general', 'menu', 'pos'] && isTenantAdmin(clientId));
        allow create: if settingsId in ['general', 'menu', 'pos'] && (settingsId == 'pos'
          ? hasTenantFeature(clientId, 'pos')
            && (isTenantFullAdmin(clientId) || request.resource.data.get('completedOrders', []).size() == 0)
          : hasTenantFeature(clientId, 'settings'));
        allow update: if settingsId in ['general', 'menu', 'pos'] && (settingsId == 'pos'
          ? hasTenantFeature(clientId, 'pos')
            && (
              isTenantFullAdmin(clientId)
              || request.resource.data.get('completedOrders', []) == resource.data.get('completedOrders', [])
            )
          : hasTenantFeature(clientId, 'settings'));
        allow delete: if settingsId in ['general', 'menu', 'pos'] && (settingsId == 'pos' ? isTenantFullAdmin(clientId) : hasTenantFeature(clientId, 'settings'));
      }

      match /completedOrders/{orderId} {
        allow read: if isTenantAdmin(clientId);
        // Staff may record a sale tied to themselves — not invent cancelled/empty
        // tickets or attribute the close to another UID.
        allow create: if hasTenantFeature(clientId, 'pos')
          && request.resource.data.get('status', 'completed') == 'completed'
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= 50000000
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 100
          && request.resource.data.completedAt is string
          && request.resource.data.completedAt.size() >= 20
          && request.resource.data.completedAt.size() <= 40
          && request.resource.data.tableId is string
          && request.resource.data.tableName is string
          && request.resource.data.currency is string
          && request.resource.data.completedByUid == request.auth.uid;
        allow update, delete: if isTenantFullAdmin(clientId);
      }

      match /shifts/{shiftId} {
        allow read: if isTenantAdmin(clientId);
        allow create: if hasTenantFeature(clientId, 'shift')
          && (
            (
              shiftId == 'shiftLock'
              && (
                request.resource.data.keys().hasOnly(['openShiftId'])
                || request.resource.data.keys().hasOnly(['id', 'openShiftId'])
              )
            )
            || (
              request.resource.data.status == 'open'
              && request.resource.data.openingCash is number
              && request.resource.data.openingCash >= 0
              && request.resource.data.openedAt is string
              && !('closedAt' in request.resource.data)
              && !('closingCashCounted' in request.resource.data)
              && !('variance' in request.resource.data)
            )
          );
        // Open → closed (or clear/set the single open-shift pointer). No rewriting closed history.
        allow update: if hasTenantFeature(clientId, 'shift')
          && (
            (
              shiftId == 'shiftLock'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openShiftId'])
            )
            || (
              resource.data.status == 'open'
              && request.resource.data.status == 'closed'
              && request.resource.data.openedAt == resource.data.openedAt
              && request.resource.data.openingCash == resource.data.openingCash
              && request.resource.data.currency == resource.data.currency
            )
          );
        allow delete: if isTenantFullAdmin(clientId);
      }

      match /expenses/{expenseId} {
        allow read: if isTenantAdmin(clientId);
        allow create: if hasTenantFeature(clientId, 'expenses')
          && request.resource.data.get('status', 'active') == 'active';
        allow update, delete: if isTenantFullAdmin(clientId);
      }

      match /adminProfiles/{uid} {
        allow get: if isTenantAdmin(clientId) || (signedIn() && request.auth.uid == uid);
        allow list: if isTenantFullAdmin(clientId);
        // Full admins manage users, but only a Main Admin may set/change the
        // isMainAdmin flag (prevents a full admin from crowning themselves).
        allow create: if isTenantFullAdmin(clientId)
          && (request.resource.data.get('isMainAdmin', false) == false || isTenantMainAdmin(clientId));
        allow update: if isTenantFullAdmin(clientId)
          && (request.resource.data.get('isMainAdmin', false) == resource.data.get('isMainAdmin', false) || isTenantMainAdmin(clientId));
        allow delete: if isTenantFullAdmin(clientId);
      }

      match /usernames/{username} {
        allow get, list: if false;
        allow create, update, delete: if isTenantFullAdmin(clientId);
      }

      match /auditLogs/{logId} {
        // Platform supervisors always read. Cafe staff read only when the
        // platform toggle is on and they have the audit feature (admins always).
        // Creates stay append-only and must match the signed-in actor.
        allow read: if isPlatformFullAdmin()
          || (
            get(clientRef(clientId)).data.get('auditEnabled', true) != false
            && hasTenantFeature(clientId, 'audit')
          );
        allow create: if isTenantAdmin(clientId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.entity is string
          && request.resource.data.action.size() <= 40
          && request.resource.data.entity.size() <= 40
          && request.resource.data.keys().hasAll(['action', 'entity', 'actorUid', 'at', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'action', 'entity', 'entityId', 'label', 'summary', 'changes',
            'actorUid', 'actorName', 'actorEmail', 'at', 'createdAt'
          ]);
        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        // Cafe staff + platform supervisor (including platform employees) may read.
        // Public submissions go through the Admin-SDK /api/reviews route (which also
        // updates the aggregate on the client doc), so no client-side writes.
        allow read: if isPlatformAdmin() || isTenantAdmin(clientId);
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
